# Переменные окружения для Docker.
# Скопируйте в .env и поправьте под себя:  cp .env.example .env
#
# Эти значения управляют Docker-запуском. Параметры самого сервиса
# (язык, зоны, движок и т.п.) лежат в config/settings.json.

# ============================================
# Сервер
# ============================================

# Порт сервиса, снаружи и внутри контейнера.
SERVER_PORT=5002

# Хост приёма подключений (0.0.0.0 = доступ по сети)
SERVER_HOST=0.0.0.0

# ============================================
# GPU
# ============================================

# Сколько GPU отдать контейнеру: число (1, 2, ...) или all
GPU_COUNT=1

# Какие GPU видны контейнеру (0 = первая, "0,1" = первые две)
CUDA_VISIBLE_DEVICES=0

# ============================================
# Модель
# ============================================

# cli    — llama-mtmd-cli, модель грузится на каждый проход;
# server — llama-server, модель живёт в памяти, в ответе есть logprob_min.
LLAMA_BACKEND=cli

# ============================================
# Журналы и история
# ============================================

# Сырой вывод модели по каждому проходу в logs/raw. Объёмный, включать на
# время разбора конкретного случая.
LOG_RAW_MODEL_OUTPUT=0

# Писать ли распознанное содержимое в logs/audit.jsonl (0 = только метаданные)
AUDIT_LOG_CONTENT=1

# Хранить ли историю распознаваний в data/results.db
RESULTS_DB_ENABLED=1

# ============================================
# Прочее
# ============================================

TZ=UTC
